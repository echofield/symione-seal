{
  "name": "symione-seal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A person approves an agent's irreversible action from their phone: an Ed25519 receipt bound to the exact input, verified downstream before the action runs.",
  "keywords": [
    "mcp",
    "ai-agents",
    "agentic-commerce",
    "human-in-the-loop",
    "ed25519",
    "stripe",
    "cloudflare-workers",
    "audit-log"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply symione-seal --local"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261029.1",
    "@types/node": "^24.0.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "wrangler": "4.155.0"
  }
}

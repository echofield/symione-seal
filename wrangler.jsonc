{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "symione-seal",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "symione-seal",
      "database_id": "1770ef0b-1590-4721-b1fa-248fa808e5ff",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": { "SEAL_ENV": "production" },
  "observability": { "enabled": true }
  // Secrets (scripts/make-secrets.mjs): SEAL_AGENT_KEY, SEAL_OPERATOR_HASH, SESSION_SECRET, SEAL_SIGNING_JWK.
}
